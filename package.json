{
  "name": "appstore-data-mcp",
  "version": "0.1.2",
  "description": "MCP server for live App Store and Google Play data: app details, reviews, search and top charts, via the App Store Google Play Data API.",
  "type": "module",
  "bin": {
    "appstore-data-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "app-store",
    "google-play",
    "aso",
    "itunes",
    "claude"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheValkDokk/appstore-data-mcp.git"
  },
  "homepage": "https://github.com/TheValkDokk/appstore-data-mcp#readme",
  "bugs": {
    "url": "https://github.com/TheValkDokk/appstore-data-mcp/issues"
  },
  "author": "Valk Dokk",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.TheValkDokk/appstore-data"
}

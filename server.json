{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.thevalkdokk/appstore-data",
  "title": "App Store + Google Play Data",
  "description": "Live App Store and Google Play data: app details, reviews, search, top charts for 175+ storefronts.",
  "repository": {
    "url": "https://github.com/TheValkDokk/appstore-data-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "appstore-data-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RAPIDAPI_KEY",
          "description": "RapidAPI key from https://rapidapi.com/TheValkDokk/api/app-store-google-play-data-api",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}

# Remote MCP endpoint (streamable HTTP). Multi-stage so `dist/` is built inside the image.
FROM node:22 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npm run build

FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY README.md SKILL.md ./
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["node", "dist/http.js"]
